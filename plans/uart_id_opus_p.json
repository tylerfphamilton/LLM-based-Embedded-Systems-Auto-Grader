{
  "schema_version": "0.1",
  "assignment": "uart_id_opus_p",
  "description": "Serial1 (9600 8N1) command responder: ID?, SUM?, HEX? answered with per-student values, ERR for unknown commands, empty lines ignored, no extra output.",
  "params": [
    "student_id",
    "digit_sum",
    "id_hex"
  ],
  "setup": {
    "reset": true,
    "boot_wait_ms": 1000
  },
  "assumptions": [
    "The handout does not define 'promptly'; each reply must arrive within a 500 ms window after the command is sent.",
    "A reply is accepted with either a \\r\\n or a \\n line ending, and nothing else may be sent in the window.",
    "Silence at start-up is checked for 1000 ms after the 1000 ms boot wait; output sent earlier than that is not seen.",
    "Answering for as long as the board is powered is checked by sending ID? again at the end of the test; longer operation is not tested."
  ],
  "steps": [
    {
      "op": "measure",
      "primitive": "uart_read",
      "id": "no_banner",
      "requirement": "The sketch prints nothing on Serial1 after start-up (no start-up message or debug output).",
      "baud": 9600,
      "window_ms": 1000,
      "expect": [
        {
          "op": "eq",
          "field": "byte_count",
          "value": 0
        }
      ]
    },
    {
      "op": "measure",
      "primitive": "uart_read",
      "id": "id_lf",
      "requirement": "Sending 'ID?' ending in \\n gets your 9-digit ID (with leading zeros) back as one line.",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{student_id}}\\r?\\n$"
        },
        {
          "op": "eq",
          "field": "framing_errors",
          "value": 0
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "ID?\n"
    },
    {
      "op": "measure",
      "primitive": "uart_read",
      "id": "sum_crlf",
      "requirement": "Sending 'SUM?' ending in \\r\\n gets the sum of your ID's digits back as one line.",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{digit_sum}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "SUM?\r\n"
    },
    {
      "op": "measure",
      "primitive": "uart_read",
      "id": "hex_lf",
      "requirement": "Sending 'HEX?' gets your ID as upper-case hex with no leading zeros back as one line.",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{id_hex}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "HEX?\n"
    },
    {
      "op": "measure",
      "primitive": "uart_read",
      "id": "hex_crlf",
      "requirement": "Sending 'HEX?' ending in \\r\\n also gets the hex ID back (the \\r is not part of the command).",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{id_hex}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "HEX?\r\n"
    },
    {
      "op": "measure",
      "primitive": "uart_read",
      "id": "unknown",
      "requirement": "An unknown command gets 'ERR' back as one line.",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^ERR\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "FOO?\r\n"
    },
    {
      "op": "measure",
      "primitive": "uart_read",
      "id": "empty_line",
      "requirement": "Empty lines are ignored and get no reply.",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "eq",
          "field": "byte_count",
          "value": 0
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "\r\n\n"
    },
    {
      "op": "measure",
      "primitive": "uart_read",
      "id": "sum_lf",
      "requirement": "Sending 'SUM?' ending in \\n also gets the digit sum back.",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{digit_sum}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "SUM?\n"
    },
    {
      "op": "measure",
      "primitive": "uart_read",
      "id": "id_again",
      "requirement": "The sketch keeps answering: 'ID?' sent again (ending in \\r\\n) still gets your ID back.",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{student_id}}\\r?\\n$"
        },
        {
          "op": "eq",
          "field": "framing_errors",
          "value": 0
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "ID?\r\n"
    }
  ],
  "not_graded": [
    {
      "requirement": "Comment your code.",
      "reason": "Code comments cannot be observed electrically."
    }
  ]
}
