{
  "schema_version": "0.1",
  "assignment": "button_toggle_opus_c",
  "description": "Debounced push-button toggle of the D13 LED with ON/OFF reports on Serial1 at 9600 baud. Checks the LED is off at start, that bouncy presses toggle exactly once and quickly, that bouncy releases do not toggle, the serial messages, and the internal pull-up on D2.",
  "setup": {
    "reset": true,
    "boot_wait_ms": 1000
  },
  "assumptions": [
    "The handout gives no number for 'quickly', so the LED must change within 100 ms of the first press edge, which is about when people start to notice a delay.",
    "Each press and the first release are bounced 7 times at 1 ms (7 ms of bounce) to check debouncing.",
    "Serial lines may end in either \\n or \\r\\n (println style), and nothing else may be printed during a toggle.",
    "The LED is active-high (HIGH = on), as with the Nano 33 BLE on-board LED on D13.",
    "The 'exactly once' check counts every LED edge for 500 ms after the press, so a sketch that toggles again late is also caught."
  ],
  "steps": [
    {
      "op": "drive",
      "pin": "D2",
      "action": "release"
    },
    {
      "op": "measure",
      "id": "led_off_at_start",
      "requirement": "The LED is off after reset and stays off while the button is not pressed.",
      "primitive": "logic_trace",
      "pin": "D13",
      "window_ms": 300,
      "expect": [
        {
          "op": "eq",
          "field": "final_level",
          "value": 0
        },
        {
          "op": "eq",
          "field": "edge_count",
          "value": 0
        }
      ]
    },
    {
      "op": "measure",
      "id": "press1_toggle",
      "requirement": "The first bouncy press turns the LED on exactly once, within 100 ms.",
      "primitive": "edge_delay",
      "from_pin": "D2",
      "from_edge": "falling",
      "to_pin": "D13",
      "to_edge": "any",
      "timeout_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "not_null",
          "field": "delay_ms"
        },
        {
          "op": "le",
          "field": "delay_ms",
          "value": 100
        },
        {
          "op": "eq",
          "field": "to_edge_count",
          "value": 1
        }
      ]
    },
    {
      "op": "measure",
      "id": "press1_serial",
      "requirement": "After the first press the sketch prints ON on its own line on Serial1 at 9600 baud.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^ON\\r?\\n$"
        },
        {
          "op": "eq",
          "field": "framing_errors",
          "value": 0
        }
      ]
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "bounce",
      "count": 7,
      "interval_us": 1000,
      "final_level": "low"
    },
    {
      "op": "measure",
      "id": "led_on_after_press1",
      "requirement": "The LED stays on after the first press.",
      "primitive": "logic_trace",
      "pin": "D13",
      "window_ms": 100,
      "expect": [
        {
          "op": "eq",
          "field": "final_level",
          "value": 1
        },
        {
          "op": "eq",
          "field": "edge_count",
          "value": 0
        }
      ]
    },
    {
      "op": "measure",
      "id": "release_no_toggle",
      "requirement": "Releasing the button, even with bounce, does not change the LED.",
      "primitive": "logic_trace",
      "pin": "D13",
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "eq",
          "field": "edge_count",
          "value": 0
        },
        {
          "op": "eq",
          "field": "final_level",
          "value": 1
        }
      ]
    },
    {
      "op": "measure",
      "id": "release_no_print",
      "requirement": "Releasing the button prints nothing on Serial1.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "eq",
          "field": "byte_count",
          "value": 0
        }
      ]
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "bounce",
      "count": 7,
      "interval_us": 1000,
      "final_level": "high"
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "release"
    },
    {
      "op": "wait",
      "ms": 200
    },
    {
      "op": "measure",
      "id": "press2_toggle",
      "requirement": "The second bouncy press turns the LED off exactly once, within 100 ms.",
      "primitive": "edge_delay",
      "from_pin": "D2",
      "from_edge": "falling",
      "to_pin": "D13",
      "to_edge": "any",
      "timeout_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "not_null",
          "field": "delay_ms"
        },
        {
          "op": "le",
          "field": "delay_ms",
          "value": 100
        },
        {
          "op": "eq",
          "field": "to_edge_count",
          "value": 1
        }
      ]
    },
    {
      "op": "measure",
      "id": "press2_serial",
      "requirement": "After the second press the sketch prints OFF on its own line on Serial1.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^OFF\\r?\\n$"
        },
        {
          "op": "eq",
          "field": "framing_errors",
          "value": 0
        }
      ]
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "bounce",
      "count": 7,
      "interval_us": 1000,
      "final_level": "low"
    },
    {
      "op": "measure",
      "id": "led_off_after_press2",
      "requirement": "The LED stays off after the second press.",
      "primitive": "logic_trace",
      "pin": "D13",
      "window_ms": 100,
      "expect": [
        {
          "op": "eq",
          "field": "final_level",
          "value": 0
        },
        {
          "op": "eq",
          "field": "edge_count",
          "value": 0
        }
      ]
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "release"
    },
    {
      "op": "wait",
      "ms": 300
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "low"
    },
    {
      "op": "wait",
      "ms": 300
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "release"
    },
    {
      "op": "measure",
      "id": "pullup",
      "requirement": "The button pin uses the internal pull-up, so it reads HIGH when the button is not pressed.",
      "primitive": "logic_trace",
      "pin": "D2",
      "window_ms": 50,
      "expect": [
        {
          "op": "eq",
          "field": "final_level",
          "value": 1
        }
      ]
    }
  ],
  "not_graded": [
    {
      "requirement": "Implement debouncing in software, without blocking delay() calls.",
      "reason": "How the debouncing is coded can't be seen from the pins. Only how it behaves (one toggle per bouncy press) is graded."
    },
    {
      "requirement": "Comment your code.",
      "reason": "Code style and comments can't be measured electrically."
    }
  ]
}
