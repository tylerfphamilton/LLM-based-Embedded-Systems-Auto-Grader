{
  "schema_version": "0.1",
  "assignment": "uart_id_sonnet_p",
  "description": "Checks the Serial1 ID responder at 9600 baud: silent after boot, correct replies for ID?/SUM?/HEX?, ERR for unknown commands, both line endings, empty lines ignored, and still answering later.",
  "params": [
    "student_id",
    "digit_sum",
    "id_hex"
  ],
  "setup": {
    "reset": true,
    "boot_wait_ms": 1000
  },
  "steps": [
    {
      "op": "measure",
      "id": "silent_boot",
      "requirement": "The sketch prints nothing on Serial1 until it receives a command.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 500,
      "expect": [
        {
          "op": "eq",
          "field": "byte_count",
          "value": 0
        }
      ]
    },
    {
      "op": "measure",
      "id": "id_lf",
      "requirement": "ID? (ending in \\n) is answered with your 9-digit ID, leading zeros kept.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{student_id}}\\r?\\n$"
        },
        {
          "op": "eq",
          "field": "framing_errors",
          "value": 0
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "ID?\n"
    },
    {
      "op": "measure",
      "id": "id_crlf",
      "requirement": "ID? ending in \\r\\n is accepted and answered with your ID.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{student_id}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "ID?\r\n"
    },
    {
      "op": "measure",
      "id": "sum_lf",
      "requirement": "SUM? is answered with the sum of your ID digits.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{digit_sum}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "SUM?\n"
    },
    {
      "op": "measure",
      "id": "sum_crlf",
      "requirement": "SUM? ending in \\r\\n is accepted.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{digit_sum}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "SUM?\r\n"
    },
    {
      "op": "measure",
      "id": "hex_lf",
      "requirement": "HEX? is answered with your ID in upper-case hex without leading zeros.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{id_hex}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "HEX?\n"
    },
    {
      "op": "measure",
      "id": "hex_crlf",
      "requirement": "HEX? ending in \\r\\n is accepted.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{id_hex}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "HEX?\r\n"
    },
    {
      "op": "measure",
      "id": "err_unknown",
      "requirement": "An unknown command is answered with ERR.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^ERR\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "HELLO\n"
    },
    {
      "op": "measure",
      "id": "err_crlf",
      "requirement": "An unknown command ending in \\r\\n gives ERR (the \\r is not part of the command).",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^ERR\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "XYZ?\r\n"
    },
    {
      "op": "measure",
      "id": "empty_lines",
      "requirement": "Empty lines are ignored: only the ID reply comes back.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 400,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{student_id}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "\n\r\n\nID?\n"
    },
    {
      "op": "measure",
      "id": "multi_cmd",
      "requirement": "Several commands sent back to back each get their own reply, in order.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 800,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{student_id}}\\r?\\n{{digit_sum}}\\r?\\n{{id_hex}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "ID?\nSUM?\nHEX?\n"
    },
    {
      "op": "wait",
      "ms": 3000
    },
    {
      "op": "measure",
      "id": "still_answering",
      "requirement": "The sketch keeps answering after it has been running for a while.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^{{student_id}}\\r?\\n$"
        }
      ]
    },
    {
      "op": "uart_send",
      "baud": 9600,
      "data": "ID?\n"
    },
    {
      "op": "measure",
      "id": "no_extra_output",
      "requirement": "Nothing extra is printed after the replies.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 500,
      "expect": [
        {
          "op": "eq",
          "field": "byte_count",
          "value": 0
        }
      ]
    }
  ],
  "assumptions": [
    "The handout gives no reply deadline, so each reply must arrive within a 300 ms window (800 ms for three back-to-back commands).",
    "The silence check runs after the 1000 ms boot wait, so it only sees output printed after the board has finished starting.",
    "Replies may end in \\n or \\r\\n, so the expected text allows an optional \\r before the final \\n.",
    "Unknown-command tests use HELLO and XYZ? as examples of anything else."
  ],
  "not_graded": [
    {
      "requirement": "Comment your code.",
      "reason": "Code comments cannot be observed electrically."
    }
  ]
}
