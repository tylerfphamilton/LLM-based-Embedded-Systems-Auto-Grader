{
  "schema_version": "0.1",
  "assignment": "button_toggle_opus_b",
  "description": "Debounced button toggle: button on D2 (active low, INPUT_PULLUP) toggles the LED on D13 once per bouncy press and prints ON/OFF on Serial1 at 9600 baud.",
  "setup": {
    "reset": true,
    "boot_wait_ms": 1000
  },
  "assumptions": [
    "The handout gives no number for 'quickly', so the LED must change within 100 ms of the first press edge, which is about where people start to notice a delay.",
    "A bouncy press is 5 edges 200 us apart, ending LOW (pressed).",
    "Releasing the button is the board letting go of D2, so the student's INPUT_PULLUP pulls it high.",
    "Serial lines may end with \\n or \\r\\n.",
    "Releasing the button must not toggle the LED (only presses do)."
  ],
  "steps": [
    {
      "op": "drive",
      "pin": "D2",
      "action": "release"
    },
    {
      "op": "measure",
      "id": "led_off_reset",
      "requirement": "The LED is off after reset.",
      "primitive": "logic_trace",
      "pin": "D13",
      "window_ms": 300,
      "expect": [
        {
          "op": "eq",
          "field": "final_level",
          "value": 0
        },
        {
          "op": "eq",
          "field": "edge_count",
          "value": 0
        }
      ]
    },
    {
      "op": "measure",
      "id": "press1_led",
      "requirement": "The first bouncy press turns the LED on exactly once, within 100 ms.",
      "primitive": "edge_delay",
      "from_pin": "D2",
      "from_edge": "falling",
      "to_pin": "D13",
      "to_edge": "any",
      "timeout_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "not_null",
          "field": "delay_ms"
        },
        {
          "op": "le",
          "field": "delay_ms",
          "value": 100
        },
        {
          "op": "eq",
          "field": "to_edge_count",
          "value": 1
        }
      ]
    },
    {
      "op": "measure",
      "id": "press1_serial",
      "requirement": "The first press prints ON on its own line on Serial1.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^ON\\r?\\n$"
        },
        {
          "op": "eq",
          "field": "framing_errors",
          "value": 0
        }
      ]
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "bounce",
      "count": 5,
      "interval_us": 200,
      "final_level": "low"
    },
    {
      "op": "wait",
      "ms": 200
    },
    {
      "op": "measure",
      "id": "release1_led",
      "requirement": "Releasing the button does not change the LED (it stays on).",
      "primitive": "logic_trace",
      "pin": "D13",
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "eq",
          "field": "edge_count",
          "value": 0
        },
        {
          "op": "eq",
          "field": "final_level",
          "value": 1
        }
      ]
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "release"
    },
    {
      "op": "wait",
      "ms": 200
    },
    {
      "op": "measure",
      "id": "press2_led",
      "requirement": "The second bouncy press turns the LED off exactly once, within 100 ms.",
      "primitive": "edge_delay",
      "from_pin": "D2",
      "from_edge": "falling",
      "to_pin": "D13",
      "to_edge": "any",
      "timeout_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "not_null",
          "field": "delay_ms"
        },
        {
          "op": "le",
          "field": "delay_ms",
          "value": 100
        },
        {
          "op": "eq",
          "field": "to_edge_count",
          "value": 1
        }
      ]
    },
    {
      "op": "measure",
      "id": "press2_serial",
      "requirement": "The second press prints OFF on its own line on Serial1.",
      "primitive": "uart_read",
      "baud": 9600,
      "window_ms": 500,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "matches",
          "field": "text",
          "value": "^OFF\\r?\\n$"
        },
        {
          "op": "eq",
          "field": "framing_errors",
          "value": 0
        }
      ]
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "bounce",
      "count": 5,
      "interval_us": 200,
      "final_level": "low"
    },
    {
      "op": "wait",
      "ms": 200
    },
    {
      "op": "measure",
      "id": "release2_led",
      "requirement": "Releasing the button again leaves the LED off.",
      "primitive": "logic_trace",
      "pin": "D13",
      "window_ms": 300,
      "concurrent_with_next": true,
      "expect": [
        {
          "op": "eq",
          "field": "edge_count",
          "value": 0
        },
        {
          "op": "eq",
          "field": "final_level",
          "value": 0
        }
      ]
    },
    {
      "op": "drive",
      "pin": "D2",
      "action": "release"
    }
  ],
  "not_graded": [
    {
      "requirement": "Implement debouncing in software, without blocking delay() calls.",
      "reason": "The pins can't show how the debouncing is done. Only its effect (one toggle per press, fast response) is tested."
    },
    {
      "requirement": "Comment your code.",
      "reason": "Code style can't be observed electrically."
    }
  ]
}
