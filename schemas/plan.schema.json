    "AnalogReadStep": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "measure",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "expect": {
          "items": {
            "discriminator": {
              "mapping": {
                "approx": "#/$defs/ApproxExpectation",
                "contains": "#/$defs/TextExpectation",
                "eq": "#/$defs/CompareExpectation",
                "ge": "#/$defs/CompareExpectation",
                "gt": "#/$defs/CompareExpectation",
                "in_range": "#/$defs/RangeExpectation",
                "is_null": "#/$defs/NullExpectation",
                "le": "#/$defs/CompareExpectation",
                "lt": "#/$defs/CompareExpectation",
                "matches": "#/$defs/TextExpectation",
                "ne": "#/$defs/CompareExpectation",
                "not_null": "#/$defs/NullExpectation"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ApproxExpectation"
              },
              {
                "$ref": "#/$defs/CompareExpectation"
              },
              {
                "$ref": "#/$defs/RangeExpectation"
              },
              {
                "$ref": "#/$defs/TextExpectation"
              },
              {
                "$ref": "#/$defs/NullExpectation"
              }
            ]
          },
          "title": "Expect",
          "type": "array"
        },
        "concurrent_with_next": {
          "default": false,
          "description": "Arm this measurement, run the next step(s) as stimulus, then collect.",
          "title": "Concurrent With Next",
          "type": "boolean"
        },
        "primitive": {
          "const": "analog_read",
          "title": "Primitive",
          "type": "string"
        },
        "pin": {
          "title": "Pin",
          "type": "string"
        },
        "samples": {
          "title": "Samples",
          "type": "integer"
        }
      },
      "required": [
        "op",
        "id",
        "requirement",
        "expect",
        "primitive",
        "pin",
        "samples"
      ],
      "title": "AnalogReadStep",
      "type": "object"
    },
