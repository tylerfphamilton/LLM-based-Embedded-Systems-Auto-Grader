          "default": null,
          "title": "Id"
        },
        "baud": {
          "title": "Baud",
          "type": "integer"
        },
        "data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "hex": {
          "anyOf": [
            {
              "pattern": "^([0-9A-Fa-f]{2})+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hex"
        }
      },
      "required": [
        "op",
        "baud"
      ],
      "title": "UartSendStep",
      "type": "object"
    },
    "WaitStep": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "wait",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "ms": {
          "title": "Ms",
          "type": "integer"
        }
      },
      "required": [
        "op",
        "ms"
      ],
      "title": "WaitStep",
      "type": "object"
    }
  },
