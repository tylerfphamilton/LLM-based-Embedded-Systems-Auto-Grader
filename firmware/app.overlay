/*
 * Board-specific devicetree additions for the grader rig.
 *
 * grader,host-uart: the UART that talks to the PC. On the Nucleo-L476RG, USART2
 * (PA2/PA3) is wired to the ST-Link, which exposes it as a USB COM port.
 *
 * Todo later: measurement pins, timers, the student UART (USART1), DAC, ADC and I2C go
 * here too, matching config/pinmap.yaml in the host repo.
 */

/ {
    chosen {
        grader,host-uart = &usart2;
    };
};

&usart2 {
    current-speed = <115200>;
};

/*
 * TIM2 is the capture timer for FREQ (src/capture.c drives it directly with STM32 LL).
 * The board file gives TIM2 to a PWM output on PB10; turn that off so nothing else
 * claims the timer or its interrupt.
 */
&pwm2 {
    status = "disabled";
};