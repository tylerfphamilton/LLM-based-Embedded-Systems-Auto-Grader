/*
 * Board-specific devicetree additions for the grader rig.
 *
 * grader,host-uart: the UART that talks to the PC. On the Nucleo-L476RG, USART2
 * (PA2/PA3) is wired to the ST-Link, which exposes it as a USB COM port.
 *
 * Todo later: measurement pins, timers, the student UART (USART1), DAC, ADC and I2C go
 * here too, matching config/pinmap.yaml in the host repo.
 */

/ {
    chosen {
        grader,host-uart = &usart2;
    };
};

&usart2 {
    current-speed = <115200>;
};

/*
 * TIM2 is the capture timer for FREQ (src/capture.c drives it directly with STM32 LL).
 * The board file gives TIM2 to a PWM output on PB10; turn that off so nothing else
 * claims the timer or its interrupt.
 */
&pwm2 {
    status = "disabled";
};

/*
 * USART1 (PA9 TX / PA10 RX) talks to the student's Serial1. src/student_uart.c drives it
 * directly with STM32 LL so it can count framing errors per byte and change the baud on
 * every command; turn off Zephyr's driver so it doesn't claim the USART or its interrupt.
 */
&usart1 {
    status = "disabled";
};

/*
 * System clock from the 32.768 kHz crystal instead of the internal RC oscillator.
 *
 * The board default runs the PLL from HSI16, an RC oscillator that can be off by ~1%,
 * and every FREQ/timing measurement inherits that error. Here MSI (4 MHz) runs in
 * "PLL mode": the hardware keeps trimming it against the LSE crystal (±20 ppm on the
 * Nucleo), and the PLL multiplies it up to the same 80 MHz as before:
 *     4 MHz / div-m 1 * mul-n 40 = 160 MHz VCO, / div-r 2 = 80 MHz SYSCLK
 * LSE is already enabled by the board file; the clock driver starts it before MSI.
 */
&clk_msi {
    status = "okay";
    msi-range = <6>;        /* 4 MHz */
    msi-pll-mode;           /* lock MSI to the LSE crystal */
};

&pll {
    clocks = <&clk_msi>;
    div-m = <1>;
    mul-n = <40>;
    div-r = <2>;
    div-q = <2>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(80)>;
};
